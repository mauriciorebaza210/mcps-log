{
  "rewrites": [
    { "source": "/api/qbo/:op", "destination": "/api/qbo?op=:op" },
    { "source": "/api/quotes/:op", "destination": "/api/quotes?op=:op" },
    { "source": "/api/email/heartbeat", "destination": "/api/email?op=heartbeat" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/proposal-approval.html", "destination": "/agreement.html" },
    { "source": "/margins", "destination": "/margins.html" },
    { "source": "/monitor", "destination": "/monitor.html" },
    { "source": "/sms", "destination": "/sms.html" },
    { "source": "/startup-request", "destination": "/startup-request.html" },
    { "source": "/builder-portal", "destination": "/builder-portal.html" },
    { "source": "/service", "destination": "/service-request.html" }
  ],
  "crons": [
    { "path": "/api/email/heartbeat", "schedule": "0 15 * * *" }
  ]
}
